# 1. OpenAI Pythonライブラリをインストール
!pip -q install -U openai

# 2. 必要なライブラリをインポート
from google.colab import userdata
from openai import OpenAI

# 3. Colab SecretsからAPIキーを取得
api_key = userdata.get("OPENAI_API_KEY")

# 4. APIキーが設定されているか確認
if not api_key:
    raise ValueError(
        "OPENAI_API_KEY が設定されていません。\n"
        "Google Colabの「Secrets」にAPIキーを登録してください。"
    )

# 5. OpenAI APIクライアントを作成
client = OpenAI(api_key=api_key)

print("OpenAI APIの接続準備が完了しました。")
