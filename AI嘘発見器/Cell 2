}


# ============================================================
# 4. ゲームデータの整合性チェック
# ============================================================

suspects = game["suspects"]

# 容疑者が3人であることを確認
assert len(suspects) == 3, "容疑者は3人に設定してください。"

# 嘘つきが1人だけであることを確認
liar_count = sum(
    suspect["is_liar"]
    for suspect in suspects.values()
)

assert liar_count == 1, "嘘つきは必ず1人に設定してください。"

# 容疑者のIDがA・B・Cであることを確認
assert set(suspects.keys()) == {"A", "B", "C"}, \
    "容疑者IDはA・B・Cに設定してください。"


# ============================================================
# 5. データの読み込み確認
# ============================================================

print("ゲームデータの読み込みが完了しました。")
print("事件名：", game["case_title"])
print("容疑者数：", len(suspects))
print("証拠数：", len(game["evidence"]))

print("\n容疑者一覧")
for suspect_id, suspect in suspects.items():
    print(f"{suspect_id}：{suspect['name']}（{suspect['role']}）")
