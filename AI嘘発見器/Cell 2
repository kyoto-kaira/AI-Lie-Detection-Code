    プレイヤーは3人に質問し、証言の矛盾を見つけて
    嘘をついている人物を特定してください。
    """,

    # 2. 容疑者データ
    "suspects": {

        # 容疑者A：田中
        "A": {
            "name": "田中",
            "role": "美術館職員",

            "initial_statement": (
                "19時から19時30分まで、受付や休憩室にいました。"
            ),

            "is_liar": False,

            "truth": [
