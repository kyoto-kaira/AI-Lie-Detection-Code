            "is_liar": True,

            "truth": [
                "19時には美術館にいた",
                "19時15分には展示室にいた",
                "19時30分頃に美術館を出た"
            ],

            "lie": [
                "19時から19時30分まで、ずっとカフェにいた"
            ],

            "personality": "少し緊張しており、質問に慎重に答える"
        },

        # 容疑者C：鈴木
        "C": {
            "name": "鈴木",
