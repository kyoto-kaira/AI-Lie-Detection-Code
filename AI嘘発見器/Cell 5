# ============================================================

def run_interrogation():

    print("=" * 50)
    print("AI嘘発見ゲーム：美術館の絵画盗難事件")
    print("=" * 50)
    print("容疑者に自由に質問して、証言の矛盾を探してください。")
    print("終了する場合は「終了」と入力してください。")
    print("")

    while True:

        # 1. 容疑者を選択
        print("\n【容疑者一覧】")

        for suspect_id, suspect in game["suspects"].items():
            print(
                f"{suspect_id}：{suspect['name']} "
                f"（{suspect['role']}）"
            )

        suspect_id = input(
            "\n質問する容疑者を選択してください（A/B/C）："
        ).strip().upper()

        # 2. ゲームを終了
        if suspect_id == "終了":
            print("\n取り調べを終了します。")
            break

        # 3. 入力チェック
        if suspect_id not in game["suspects"]:
            print("入力が正しくありません。A、B、Cのいずれかを入力してください。")
            continue

        suspect_name = game["suspects"][suspect_id]["name"]

        # 4. 会話履歴を表示するか確認
        show_history = input(
            f"{suspect_name}との過去の会話を表示しますか？（y/n）："
        ).strip().lower()

        if show_history == "y":
            history = conversation_histories[suspect_id]

            if not history:
                print("まだ会話履歴はありません。")
            else:
                print(f"\n【{suspect_name}との会話履歴】")

                for message in history:
                    if message["role"] == "user":
                        print(f"あなた：{message['content']}")
                    elif message["role"] == "assistant":
                        print(f"{suspect_name}：{message['content']}")

        # 5. 質問を入力
        question = input(
            f"\n{suspect_name}への質問（終了する場合は「戻る」）："
        ).strip()

        if question == "戻る":
            continue

        if not question:
            print("質問が入力されていません。")
            continue

        # 6. APIに質問を送信して回答を取得
        try:
            answer = ask_suspect(suspect_id, question)

            print("\n" + "-" * 40)
            print(f"【{suspect_name}の回答】")
            print(answer)
            print("-" * 40)

        except Exception as e:
            print("\n回答の取得中にエラーが発生しました。")
            print("エラー内容：", str(e))
            print("API設定や通信状況を確認してください。")


# ゲームを開始
run_interrogation()
