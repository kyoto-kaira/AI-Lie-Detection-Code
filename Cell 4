# 3. AIに質問を送信する関数
def ask_suspect(suspect_id, question):

    # 入力チェック
    if suspect_id not in game["suspects"]:
        raise ValueError("容疑者IDはA・B・Cのいずれかを指定してください。")

    if not isinstance(question, str) or not question.strip():
        raise ValueError("質問を入力してください。")

    # 容疑者の名前を取得
    suspect_name = game["suspects"][suspect_id]["name"]

    # その容疑者専用のシステムプロンプトを取得
    system_prompt = system_prompts[suspect_id]

    # 過去の会話履歴を取得
    history = conversation_histories[suspect_id]

    # システムプロンプトを先頭に配置し、過去の履歴と新しい質問を結合
    messages = [
        {
            "role": "system",
            "content": system_prompt
        }
    ] + history + [
        {
            "role": "user",
            "content": question
        }
    ]

    # 4. OpenAI APIにリクエストを送信 (標準的な Chat Completions API に修正)
    response = client.chat.completions.create(
        model=MODEL,
        messages=messages
    )

    # 5. AIの回答を取得
    answer = response.choices[0].message.content

    # 6. APIが正常に回答した後で会話履歴を更新
    conversation_histories[suspect_id].append(
        {
            "role": "user",
            "content": question
        }
    )

    conversation_histories[suspect_id].append(
        {
            "role": "assistant",
            "content": answer
        }
    )

    # 7. 回答を返す
    return answer


